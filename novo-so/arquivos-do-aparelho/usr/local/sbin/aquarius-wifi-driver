#!/bin/sh
# Escolhe o driver do Wi-Fi interno (RTL8188CUS, USB 0bda:8176). Chamado pelo modprobe no lugar do rtl8192cu
# (/etc/modprobe.d/aquarius-wifi.conf). O rtl8xxxu compilado com o id 0bda:8176 (novo-so/build/wifi-rtl8xxxu) manda
# ~10x mais rapido do GPS para a rede (0,2 -> 2 MB/s, medido em 11/11/2026). Se o kernel em uso nao tiver esse
# rtl8xxxu (atualizacao de kernel, modulo nao recompilado), carrega o rtl8192cu de sempre: o Wi-Fi nunca fica sem driver.
M=${AQ_MODPROBE:-/sbin/modprobe}; V=${AQ_KERNEL:-$(uname -r)}   # AQ_*: so para teste
if modinfo -k "$V" rtl8xxxu 2>/dev/null | grep -qi '^alias:.*v0BDAp8176'; then
  exec "$M" rtl8xxxu
fi
exec "$M" --ignore-install rtl8192cu "$@"
